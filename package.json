{
  "name": "ody-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios --scheme OdyApp",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check 'App.tsx' 'index.js' 'src/**/*.{ts,tsx,js}' 'tests/**/*.{ts,tsx}' 'scripts/**/*.mjs' '*.config.js' 'jest.setup.js' 'package.json' 'app.json' 'README.md'",
    "start": "react-native start",
    "test": "jest --runInBand",
    "test:ci": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.3.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-css-interop": "0.2.6",
    "react-native-safe-area-context": "5.9.0",
    "react-native-screens": "4.27.0",
    "tailwind-merge": "3.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-worklets": "0.11.4",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.17.0"
  }
